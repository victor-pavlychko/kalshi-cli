{
  "name": "kalshi-cli",
  "version": "0.1.0",
  "description": "Simple TypeScript CLI for Kalshi trading workflows",
  "private": true,
  "type": "commonjs",
  "bin": {
    "kalshi": "dist/src/cli.js"
  },
  "scripts": {
